PORT=3000
DATABASE_URL=postgresql://dlnuf:dlnuf@localhost:5432/dlnuf?schema=espace_usager
# Secret partagé : le BFF signe les jetons des citoyens. Même valeur dans tous les services.
JWT_SECRET=dlnuf-dev-secret-a-changer
# Durée de validité du jeton de connexion d'un citoyen.
JWT_DUREE=8h
# Clé partagée qui protège les routes internes entre la passerelle et le BFF (en-tête X-Cle-Service).
CLE_SERVICE_INTERNE=dlnuf-cle-interne-a-changer

# Adresses des autres services (en local hors Docker : localhost).
PASSERELLE_URL=http://localhost:3004/api
CONSENTEMENT_URL=http://localhost:3005/api
JOURNAL_URL=http://localhost:3006/api

# Origines autorisées à appeler le BFF depuis un navigateur (séparées par des virgules, * = toutes).
CORS_ORIGINES=*
# Interface de test (simulation d'administrations) : true pour la démo, false en production.
INTERFACE_TEST_ACTIVE=true

# Délai maximal d'attente d'un autre service, en millisecondes.
DELAI_APPEL_MS=8000
