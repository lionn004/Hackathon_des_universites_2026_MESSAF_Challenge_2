// Journal de traçabilité — tables propres à ce service uniquement.
// Schéma PostgreSQL choisi via DATABASE_URL (?schema=journal).
// Les noms de champs suivent le contrat docs/openapi-journal.yaml.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Type d'administration ayant accédé aux données.
enum TypeAdministration {
  publique
  privee
}

// direct = administration publique (sans consentement explicite) ;
// consentement = administration privée (consentement explicite du citoyen).
enum TypeAcces {
  direct
  consentement
}

// Une entrée = un accès aux données d'un citoyen.
// Le journal est en AJOUT SEUL : aucune entrée n'est jamais modifiée ni supprimée
// (c'est une piste d'audit). Les noms d'administration et de démarche sont une
// photo figée au moment de l'accès, envoyée par la passerelle : si une
// administration change de nom plus tard, l'historique reste exact.
model JournalAcces {
  id                  String              @id @default(uuid()) @db.Uuid
  // Double traçabilité : propriétaire des données + personne qui a autorisé
  // (identiques pour un adulte ; pour un mineur, le décideur est le tuteur).
  titulaire_iue       String              @db.VarChar(12)
  decideur_iue        String              @db.VarChar(12)
  administration_id   String              @db.Uuid
  administration_nom  String?
  administration_type TypeAdministration?
  demarche_id         String
  demarche_nom        String?
  requete_id          String?             @db.Uuid
  registres_consultes String[]
  champs_transmis     String[]
  type_acces          TypeAcces
  date_acces          DateTime            @default(now())

  // Photo figée de la base légale de la démarche au moment de l'accès (envoyée par la
  // passerelle) : fondement, finalité, texte, référence CIL. Absente des entrées
  // antérieures à la base légale ; incluse dans l'empreinte seulement si elle est présente.
  base_fondement     String?
  base_finalite      String?
  base_texte         String?
  base_reference_cil String?

  // Chaînage par empreintes (preuve d'intégrité, services/integrite.service.js) :
  // rang dans la chaîne (1, 2, 3...), empreinte SHA-256 de l'entrée précédente, et
  // empreinte de celle-ci (son contenu + son rang + l'empreinte précédente). Modifier ou
  // supprimer une entrée, même directement en base, rompt la chaîne. Facultatifs
  // seulement pour les entrées antérieures au chaînage, scellées au démarrage du service.
  // Index simple, pas de contrainte d'unicité : la mise à jour d'une base existante (prisma
  // db push) reste sans risque ; l'unicité vient du verrou d'écriture, et la vérification
  // signale de toute façon un rang en double ou manquant.
  rang                 Int?
  empreinte_precedente String? @db.Char(64)
  empreinte            String? @db.Char(64)

  @@index([rang])
  @@index([titulaire_iue, date_acces])
  @@index([decideur_iue, date_acces])
}
